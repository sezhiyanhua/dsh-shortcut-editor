{
  "name": "dsh-shortcut-editor",
  "version": "1.0.0",
  "type": "module",
  "description": "Adds a Keyboard shortcuts settings page to DeepSeek Harness for comparing, rebinding, and restoring every app shortcut.",
  "license": "MIT",
  "author": {
    "name": "SZ",
    "url": "https://github.com/sezhiyanhua"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sezhiyanhua/dsh-shortcut-editor.git"
  },
  "homepage": "https://github.com/sezhiyanhua/dsh-shortcut-editor#readme",
  "bugs": {
    "url": "https://github.com/sezhiyanhua/dsh-shortcut-editor/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "shortcuts",
    "keybindings",
    "settings"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./icon.png": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
